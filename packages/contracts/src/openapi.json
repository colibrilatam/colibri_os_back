          },
          "tagline": {
            "type": "string",
            "example": "La mejor solución para X"
          },
          "shortDescription": {
            "type": "string",
            "example": "Descripción corta del proyecto"
          },
          "startupLinkedinUrl": {
            "type": "string",
            "example": "https://linkedin.com/company/mi-startup",
            "format": "uri"
          },
          "websiteUrl": {
            "type": "string",
            "example": "https://mistartup.com",
            "format": "uri"
          },
          "rlabProfileUrl": {
            "type": "string",
            "example": "https://rlab.com/mi-startup",
            "format": "uri"
          },
          "trajectoryStatus": {
            "type": "string",
            "enum": [
              "on_track",
              "at_risk",
              "stalled",
              "completed"
            ]
          }
        }
      }
    }
  }
}