  "info": {
    "title": "Colibrí OS API",
    "description": "API del sistema Colibrí OS — RaaS (Reputación como Servicio)",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "Correo electrónico del usuario registrado",
            "example": "juanperez@mail.com",
            "format": "email"
          },
          "password": {
            "type": "string",
            "description": "Contraseña del usuario",
            "example": "MiPass@123",
            "minLength": 1
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "AuthResponseDto": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Usuario logueado con éxito"
          },
          "token": {
            "type": "string",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
          }
        },
        "required": [
          "message",
          "token"
        ]
      },
      "CreateUserDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "Correo electrónico del usuario (único)",
            "example": "juanperez@mail.com",
            "format": "email"
          },
          "password": {
            "type": "string",
            "description": "Contraseña del usuario (debe ser fuerte)",
            "example": "MiPass@123",
            "minLength": 8,
            "maxLength": 15
          },
          "confirmPassword": {
            "type": "string",
            "description": "Confirmación de la contraseña",
            "example": "MiPass@123"
          },
          "fullName": {
            "type": "string",
            "description": "Nombre completo del usuario",
            "example": "Juan Perez"
          }
        },
        "required": [
          "email",
          "password",
          "confirmPassword",
          "fullName"
        ]
      },
      "RegisterResponseDto": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Usuario registrado con éxito"
          },
          "token": {
            "type": "string",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
          }
        },
        "required": [
          "message",
          "token"
        ]
      },
      "UserResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "fullName": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "entrepreneur",
              "mentor",
              "evaluator",
              "mecenas_semilla",
              "mecenas_fundacional",
              "mecenas_cambio",
              "admin",
              "guest"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "inactive",
              "suspended"
            ]
          },
          "provider": {
            "type": "string",
            "enum": [
              "local",
              "google"
            ]
          },
          "linkedinId": {
            "type": "string",
            "nullable": true
          },
          "googleId": {
            "type": "string",
            "nullable": true
          },
          "cryptoWallet": {
            "type": "string",
            "nullable": true
          },
          "credentialsWallet": {
            "type": "string",
            "nullable": true
          },
          "adnHash": {
            "type": "string",
            "nullable": true
          },
          "bio": {
            "type": "string",
            "nullable": true
          },
          "avatar": {
            "type": "string",
            "nullable": true
          },
          "gender": {
            "type": "string",
            "enum": [
              "male",
              "female",
              "non_binary",
              "other",
              "prefer_not_to_say"
            ],
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "email",
          "fullName",
          "role",
          "status",
          "provider",
          "createdAt",
          "updatedAt"
        ]
      },
      "UpdateUserDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "Correo electrónico del usuario (único)",
            "example": "juanperez@mail.com"
          },
          "fullName": {
            "type": "string",
            "description": "Nombre completo del usuario",
            "example": "Juan Perez"
          },
          "linkedinId": {
            "type": "string",
            "description": "ID de LinkedIn del usuario",
            "example": "https://www.linkedin.com/in/juanperez"
          },
          "cryptoWallet": {
            "type": "string",
            "description": "Dirección de billetera cripto del usuario",
            "example": "0x1234567890abcdef"
          },
          "credentialsWallet": {
            "type": "string",
            "description": "Dirección de billetera de credenciales del usuario",
            "example": "0x1234567890abcdef"
          },
          "adnHash": {
            "type": "string",
            "description": "Hash del ADN del usuario",
            "example": "0x1234567890abcdef"
          },
          "bio": {
            "type": "string",
            "description": "Biografía del usuario",
            "example": " Ingeniero de software con 5 años de experiencia"
          },
          "avatar": {
            "type": "string",
            "description": "URL del avatar del usuario",
            "example": "https://www.example.com/avatar.jpg"
          }
        },
        "required": [
          "email",
          "fullName",
          "linkedinId",
          "cryptoWallet",
          "credentialsWallet",
          "adnHash",
          "bio",
          "avatar"
        ]
      },
      "ChangeUserRoleDto": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "entrepreneur",
              "mentor",
              "evaluator",
              "mecenas_semilla",
              "mecenas_fundacional",
              "mecenas_cambio",
              "admin",
              "guest"
            ],
            "example": "evaluator"
          },
          "reason": {
            "type": "string",
            "description": "Motivo auditable del cambio de rol",
            "example": "Designación formal como evaluador del piloto."
          }
        },
        "required": [
          "role",
          "reason"
        ]
      },
      "CreateProjectDto": {
        "type": "object",
        "properties": {
          "projectName": {
            "type": "string",
            "example": "Mi Startup",
            "minLength": 1
          },
          "image": {
            "type": "string",
            "format": "binary",
            "description": "Imagen del proyecto"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "inactive",
              "closed",
              "suspended"
            ]
          },
          "country": {
            "type": "string",
            "example": "Argentina"
          },
          "industry": {
            "type": "string",
            "example": "Tecnología"
          },
          "tagline": {
            "type": "string",
            "example": "La mejor solución para X"
          },
          "shortDescription": {
            "type": "string",
            "example": "Descripción corta del proyecto"
          },
          "startupLinkedinUrl": {
            "type": "string",
            "example": "https://linkedin.com/company/mi-startup",
            "format": "uri"
          },
          "websiteUrl": {
            "type": "string",
            "example": "https://mistartup.com",
            "format": "uri"
          },
          "rlabProfileUrl": {
            "type": "string",
            "example": "https://rlab.com/mi-startup",
            "format": "uri"
          },
          "trajectoryStatus": {
            "type": "string",
            "enum": [
              "on_track",
              "at_risk",
              "stalled",
              "completed"
            ]
          }
        },
        "required": [
          "projectName"
        ]
      },
      "ProjectResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "ownerUserId": {
            "type": "string",
            "format": "uuid"
          },
          "projectName": {
            "type": "string",
            "example": "Mi Startup",
            "minLength": 1
          },
          "projectImageUrl": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "inactive",
              "closed",
              "suspended"
            ]
          },
          "country": {
            "type": "string",
            "nullable": true
          },
          "industry": {
            "type": "string",
            "nullable": true
          },
          "tagline": {
            "type": "string",
            "nullable": true
          },
          "shortDescription": {
            "type": "string",
            "nullable": true
          },
          "startupLinkedinUrl": {
            "type": "string",
            "nullable": true,
            "format": "uri"
          },
          "websiteUrl": {
            "type": "string",
            "nullable": true,
            "format": "uri"
          },
          "rlabProfileUrl": {
            "type": "string",
            "nullable": true,
            "format": "uri"
          },
          "openedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "closedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "closeReason": {
            "type": "string",
            "nullable": true
          },
          "currentTramoId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "currentPacId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "trajectoryStatus": {
            "type": "string",
            "enum": [
              "on_track",
              "at_risk",
              "stalled",
              "completed"
            ],
            "nullable": true
          },
          "nftImageUrl": {
            "type": "string",
            "nullable": true
          },
          "lastActivityAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "ownerUserId",
          "projectName",
          "status",
          "createdAt",
          "updatedAt"
        ]
      },
      "UpdateProjectDto": {
        "type": "object",
        "properties": {
          "projectName": {
            "type": "string",
