# APP
NODE_ENV=development
PORT=3000

# DATABASE URL
# Usada por seeds / migrations / scripts que leen data-source.ts
DATABASE_URL=postgresql://postgres:TU_PASSWORD_LOCAL@localhost:5432/TU_DB_LOCAL

# DATABASE
# Usada por la app en desarrollo
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=TU_PASSWORD_LOCAL
DB_NAME=colibri_db

# SWAGGER
SWAGGER_ENABLED=true

# JWT
# SEC-002: genera un valor único de 32+ caracteres. Ejemplo:
#   openssl rand -hex 32
# El validator exige MinLength(32); un placeholder más corto impide el boot.
JWT_SECRET=genera_una_clave_unica_de_32_o_mas_caracteres_aqui
# Tiempo de validez del token (también define la duración máxima de la sesión).
JWT_EXPIRES_IN=7d
# Duración de la cookie HttpOnly emitida tras login/register/Google OAuth.
AUTH_COOKIE_MAX_AGE_MS=604800000

# GOOGLE AUTH
GOOGLE_CLIENT_ID=tu_client_id_aqui
GOOGLE_CLIENT_SECRET=tu_client_secret_aqui
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# CLOUDINARY
# Requeridas para cargar, firmar y gestionar archivos de evidencia.
CLOUDINARY_CLOUD_NAME=tu_cloud_name_aqui
CLOUDINARY_API_KEY=tu_api_key_aqui
CLOUDINARY_API_SECRET=tu_api_secret_aqui

# FRONTEND
# Lista separada por comas de orígenes permitidos por CORS.
FRONTEND_URL=http://localhost:3000

# BLOCKCHAIN
# JSON: chainId -> RPC URL
BLOCKCHAIN_RPC_URLS={"137":"https://polygon-rpc.com"}

# JSON: chainId -> confirmations required
BLOCKCHAIN_CONFIRMATIONS={"137":12}

# Fallback cuando una red no aparece en BLOCKCHAIN_CONFIRMATIONS
BLOCKCHAIN_DEFAULT_CONFIRMATIONS=12

# OPS-004: fuerza TLS en la conexión a Postgres. No definir/deshabilitar en producción.
DATABASE_SSL=true

# SEED (SEC-002)
# Si se define (>= 8 chars), se usa como contraseña base de las cuentas demo.
# Si no, se genera una aleatoria y NO se imprime a stdout. Las cuentas demo
# se acceden vía POST /auth/demo-login, que no usa password.
SEED_USERS_PASSWORD=

# Hosts permitidos para el seed, separados por comas.
# Por defecto siempre se permite localhost/127.0.0.1/::1.
# Ejemplo: SEED_ALLOWED_HOSTS=demo-db.internal
SEED_ALLOWED_HOSTS=