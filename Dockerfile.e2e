# QA-001 — imagen del backend para el entorno E2E aislado.
#
# A diferencia del Dockerfile de producción, conserva devDependencies y el
# código fuente para poder ejecutar migraciones y el seeder E2E (ts-node) con
# NODE_ENV=test. NO usar esta imagen en producción.
FROM node:22-alpine

WORKDIR /app

COPY package.json package-lock.json ./
COPY packages ./packages
RUN npm ci

COPY . .
RUN npm run build

EXPOSE 3000

# `nest build` emite `dist/src/main.js` (tsconfig.build incluye src/ y scripts/).
CMD ["sh", "-c", "npm run migration:run && npm run seed:e2e && node dist/src/main.js"]
