# SEC-002 / PR-BE6: variables del entorno demo.
#
# Uso:
#   cp .env.demo.example .env.demo
#   # Completar JWT_SECRET y las credenciales que apliquen.
#   docker compose -f docker-compose.demo.yml up -d
#
# Este archivo NO contiene credenciales reales. Solo placeholders.

# APP
# NODE_ENV=demo se setea en docker-compose.demo.yml, no aqui.
PORT=3032

# DATABASE (demo local en contenedor)
# La URL se arma en docker-compose.demo.yml a partir de estas variables.
DEMO_DB_USER=postgres
DEMO_DB_PASSWORD=demo_password_local
DEMO_DB_NAME=colibri_demo
DEMO_DB_PORT=5433

# JWT
# SEC-002: genera un valor único de 32+ caracteres.
#   openssl rand -hex 32
JWT_SECRET=

# GOOGLE AUTH (opcional en demo)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3032/api/v1/auth/google/callback

# CLOUDINARY (opcional en demo)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# FRONTEND
FRONTEND_URL=http://localhost:3031

# BLOCKCHAIN
BLOCKCHAIN_RPC_URLS={"137":"https://polygon-rpc.com"}
BLOCKCHAIN_CONFIRMATIONS={"137":12}
BLOCKCHAIN_DEFAULT_CONFIRMATIONS=12

# SEED
# La password de las cuentas demo se genera aleatoria si no se define.
# Las cuentas se acceden via POST /auth/demo-login (sin password).
SEED_USERS_PASSWORD=

# Hosts permitidos para el seed. db-demo es el hostname del contenedor.
SEED_ALLOWED_HOSTS=db-demo